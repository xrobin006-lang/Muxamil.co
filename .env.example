# ============================================================
# Muxamil.co (CommHub) — Environment Variables
# ============================================================
# Copy this file to `.env` (local) or paste the values into your
# Vercel project → Settings → Environment Variables.
# NEVER commit your real .env file or share the secret keys.

# ---------- AI (Google Gemini) ----------
# Primary AI provider for all AI features (admin AI replies, etc.).
# Get a key at https://aistudio.google.com/apikey
# Falls back automatically to the bundled z-ai SDK when Gemini is
# unreachable (e.g. unsupported source region), so AI never goes dark.
AI_API_KEY=your_google_gemini_api_key_here
# Any Gemini model available to your key.
AI_MODEL=gemini-3.6-flash

# ---------- Supabase (database + auth + storage) ----------
# Project URL: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key: Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Secret (service) key — SERVER-SIDE ONLY, never expose to the client.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ---------- Session security ----------
# Long random string used to sign JWT session cookies (openssl rand -hex 32).
SESSION_SECRET=generate_a_long_random_string_here

# ---------- Admin bootstrap (FIRST RUN ONLY) ----------
# Credentials used once to provision the initial CEO/admin account.
# Change or remove after the account exists. MUST be strong.
# IMPORTANT: values containing # or $ MUST be wrapped in double quotes,
# otherwise dotenv strips them (e.g. Pass#123$ → "Pass").
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD="change_this_strong_password"

# ---------- Realtime service (optional, self-hosted) ----------
# The bundled socket.io mini-service (mini-services/realtime-service).
# Leave at defaults for local dev. For Vercel, either host the service
# elsewhere (Railway/Render/Fly) and point REALTIME_SERVICE_URL at it,
# or leave it unreachable — the app degrades gracefully to polling.
REALTIME_SERVICE_URL=http://localhost:3004
# Shared secret between Next.js API routes and the realtime service.
INTERNAL_API_KEY=generate_another_random_string_here

# ---------- Local development database (Prisma / SQLite) ----------
# Used only for local dev tooling (db:push etc.). Production runs on Supabase.
DATABASE_URL=file:./db/custom.db

# ---------- Web Push (VAPID) ----------
# Generate once: npx web-push generate-vapid-keys (or require('web-push').generateVAPIDKeys()).
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
