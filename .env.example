# ============================================================================
# Muxamil.co — environment variables
# ============================================================================
# Copy this file to `.env.local` (local development) and fill in the values.
# On Vercel, set the same variables in: Project → Settings → Environment
# Variables. NEVER commit real values — .env files are git-ignored.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_* values are embedded in the client bundle at BUILD time —
# set them BEFORE running `npm run build` / deploying to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API → Project API keys → "Publishable" (a.k.a. anon) key.
# Safe for the browser — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Project Settings → API → Project API keys → "Secret" (a.k.a. service_role)
# key. SERVER-SIDE ONLY — bypasses RLS. Never expose it in client code.
SUPABASE_SECRET_KEY=your-secret-service-role-key

# ── App session ─────────────────────────────────────────────────────────────
# Secret used to sign the httpOnly session cookie JWT (HS256).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# ── Admin bootstrap (privileged-field bridge) ───────────────────────────────
# Credentials of the ADMIN Supabase Auth account. The server signs in with
# them to obtain a short-lived admin JWT for verify/block operations (the
# database trigger rejects service-role writes to those fields).
# This account must already exist in Supabase Auth with an admin profile —
# see README.md → "Admin Setup".
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Realtime (OPTIONAL — the app is fully functional without it) ────────────
# Leave all three empty for REST-only mode (no live push updates, no presence;
# everything else works — REST APIs are the source of truth).
#
# Server-side: where the Next.js API routes POST broadcast events to
# (the control API of mini-services/realtime-service).
REALTIME_SERVICE_URL=
# Shared secret between the Next.js app and the realtime service.
# Generate one with:  openssl rand -hex 16
INTERNAL_API_KEY=
# Client-side: socket.io endpoint the browser connects to. Examples:
#   https://rt.example.com        (realtime service on its own host)
#   /                             (same origin via a reverse proxy)
# Embedded at BUILD time like all NEXT_PUBLIC_* variables.
NEXT_PUBLIC_REALTIME_URL=
