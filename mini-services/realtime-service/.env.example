# Realtime service (Bun + socket.io) — copy to .env and fill in.
# Values MUST match the Next.js app's root .env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SESSION_SECRET=same_value_as_root_env_SESSION_SECRET
INTERNAL_API_KEY=same_value_as_root_env_INTERNAL_API_KEY
