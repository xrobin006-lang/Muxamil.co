# ============================================================================
# Muxamil.co realtime service — environment variables
# ============================================================================
# Copy this file to `.env` in THIS folder (mini-services/realtime-service/)
# and fill in the values. The service refuses to start when any required
# variable is missing.
# ============================================================================

# Same Supabase project as the main app (Dashboard → Project Settings → API).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret (service_role) key — used ONLY server-side to look up the member's
# role/status when a socket connects (room membership can never be spoofed).
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Must be the SAME value as SESSION_SECRET in the main app — socket
# handshakes verify the app's session cookie JWT with it.
SESSION_SECRET=

# Must be the SAME value as INTERNAL_API_KEY in the main app — guards the
# internal /broadcast control API.
INTERNAL_API_KEY=

# Ports (defaults shown; change if something else uses them).
# SOCKET_PORT  — the socket.io server the browsers connect to
# CONTROL_PORT — the localhost-only control API the Next.js app POSTs to
SOCKET_PORT=3003
CONTROL_PORT=3004
